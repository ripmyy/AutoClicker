<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoClicker"
        Width="550" Height="595"
        MinWidth="520" MinHeight="560"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Top Full Width: Target Window -->
            <RowDefinition Height="*"/>    <!-- 2 Columns: Interval & Options -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="2,0,2,6"
                BorderBrush="{StaticResource BgCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AutoClicker"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Desktop and background inactive window automation"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkTopMost" Content="Always on top" IsChecked="True"
                              Checked="OnTopMostChanged" Unchecked="OnTopMostChanged" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkAudio" Content="Audio cues" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Background Target Section (Full Width) -->
        <GroupBox Grid.Row="1" x:Name="GrpBackgroundTarget" Header="Target window (Alt-Tab background)">
            <StackPanel>
                <!-- Mode Radio Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="RadioModeBackground" Content="Background window (Alt-Tab)" IsChecked="True"
                                 Checked="OnTargetModeChanged"/>
                    <RadioButton x:Name="RadioModeCursor" Content="Current cursor"
                                 Checked="OnTargetModeChanged"/>
                    <RadioButton x:Name="RadioModeFixed" Content="Fixed coordinate"
                                 Checked="OnTargetModeChanged"/>
                </StackPanel>

                <!-- Interactive Target Picker Button -->
                <Button x:Name="BtnPickTarget" Content="Pick Window and Coordinate (F7)"
                        Background="#0284C7" Height="30" Margin="0,0,0,6"
                        Click="OnBtnPickTargetClicked"/>

                <!-- Window Dropdown Row -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbActiveWindows" Grid.Column="0" Height="28"
                              SelectionChanged="OnWindowSelectionChanged"/>
                    <Button x:Name="BtnRefreshWindows" Grid.Column="1" Content="Refresh"
                            Background="#334155" Margin="6,0,0,0" Width="75" Height="28"
                            Click="OnBtnRefreshWindowsClicked"/>
                </Grid>

                <!-- Coordinates, Center, and Test Click Row -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="TxtCoordX" Grid.Column="1" Text="100" TextAlignment="Center" Height="26"/>
                    <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource TextSecondary}"/>
                    <TextBox x:Name="TxtCoordY" Grid.Column="3" Text="100" TextAlignment="Center" Height="26"/>
                    <Button x:Name="BtnCenterWindow" Grid.Column="4" Content="Center"
                            Background="#334155" Margin="8,0,6,0" Height="26"
                            Click="OnBtnCenterWindowClicked"/>
                    <Button x:Name="BtnTestClick" Grid.Column="5" Content="Test click"
                            Background="{StaticResource AccentEmerald}" Width="80" Height="26"
                            Click="OnBtnTestClickClicked"/>
                </Grid>

                <TextBlock x:Name="TxtTargetSummary"
                           Text="Target: [Select or pick a window]"
                           FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" Margin="1,2,1,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. Two Columns Layout -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Click Interval & Anti-Detection -->
            <StackPanel Grid.Column="0">

                <!-- Click Interval Card -->
                <GroupBox Header="Click interval">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSpeedLabel" Grid.Column="0"
                                       Text="Speed: 10.0 CPS (100 ms)"
                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkCpsMode" Grid.Column="1" Content="CPS mode"
                                      IsChecked="True" Checked="OnCpsModeChanged" Unchecked="OnCpsModeChanged"/>
                        </Grid>

                        <!-- CPS Slider Container -->
                        <StackPanel x:Name="PanelCps">
                            <Slider x:Name="SliderCps" Minimum="1" Maximum="250" Value="10" SmallChange="1" LargeChange="10"
                                    ValueChanged="OnCpsSliderChanged" Margin="0,2,0,4"/>
                            <WrapPanel Margin="0,0,0,2">
                                <Button Content="5" Width="28" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="10" Width="28" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="16" Width="28" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="25" Width="28" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="50" Width="28" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="100" Width="34" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Exact Interval Container -->
                        <Grid x:Name="PanelInterval" Visibility="Collapsed" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="1">
                                <TextBlock Text="Hr" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtHours" Text="0" TextAlignment="Center" Height="24"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="1">
                                <TextBlock Text="Min" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtMins" Text="0" TextAlignment="Center" Height="24"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="1">
                                <TextBlock Text="Sec" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtSecs" Text="0" TextAlignment="Center" Height="24"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="1">
                                <TextBlock Text="ms" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtMs" Text="100" TextAlignment="Center" Height="24"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Anti-Detection Jitter Card -->
                <GroupBox Header="Anti-detection (Jitter)">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Random variation"
                                       Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkJitter" Grid.Column="1" Content="Enable" IsChecked="False"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Delay (± ms)" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                <TextBox x:Name="TxtJitterMs" Text="15" Margin="0,2,0,0" TextAlignment="Center" Height="24"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Scatter (± px)" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                <TextBox x:Name="TxtJitterPx" Text="3" Margin="0,2,0,0" TextAlignment="Center" Height="24"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <!-- RIGHT COLUMN: Click Options & Click Repeat -->
            <StackPanel Grid.Column="2">

                <!-- Click Options Card -->
                <GroupBox Header="Click options">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mouse button" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbMouseButton" SelectedIndex="0" Height="26">
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Right"/>
                                    <ComboBoxItem Content="Middle"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Click type" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbClickType" SelectedIndex="0" Height="26">
                                    <ComboBoxItem Content="Single"/>
                                    <ComboBoxItem Content="Double"/>
                                    <ComboBoxItem Content="Triple"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hold duration (ms):" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <TextBox x:Name="TxtHoldMs" Grid.Column="1" Text="15" TextAlignment="Center" Height="24"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Click Repeat Card -->
                <GroupBox Header="Click repeat">
                    <StackPanel Margin="0,2">
                        <RadioButton x:Name="RadioRepeatInfinite" Content="Repeat until stopped" IsChecked="True" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioRepeatCount" Content="Repeat" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtRepeatCount" Text="1000" Width="55" TextAlignment="Center" Height="24"/>
                            <TextBlock Text="times" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="3" Background="#0C121D" CornerRadius="6" Padding="8,6"
                BorderBrush="{StaticResource BgCardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Badge -->
                <Border x:Name="BadgeStatus" Grid.Column="0" Background="#334155" CornerRadius="4" Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Stopped" Foreground="{StaticResource TextSecondary}"
                               FontWeight="SemiBold" FontSize="11"/>
                </Border>

                <!-- Live Metrics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMetricClicks" Text="Clicks: 0"
                               FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="8,0"/>
                    <TextBlock x:Name="TxtMetricCps" Text="0.0 CPS"
                               FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" Margin="8,0"/>
                    <TextBlock x:Name="TxtMetricTime" Text="00:00:00"
                               FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0"/>
                </StackPanel>

                <!-- Start/Stop Button -->
                <Button x:Name="BtnStartStop" Grid.Column="2" Content="Start (F6)"
                        Background="{StaticResource AccentEmerald}"
                        FontWeight="Bold" FontSize="13" Width="110" Height="32"
                        Click="OnBtnStartStopClicked"/>
            </Grid>
        </Border>

    </Grid>
</Window>
