<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoClicker Reimagined — Background &amp; High-Speed Engine"
        Width="580" Height="780"
        MinWidth="540" MinHeight="720"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable content -->
            <RowDefinition Height="Auto"/> <!-- Bottom HUD -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="4,0,4,8"
                BorderBrush="#253347" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ AUTOCLICKER REIMAGINED"
                                   Foreground="{StaticResource AccentCyan}"
                                   FontWeight="Bold" FontSize="16"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="v2.0.0" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Alt-Tab Background Window Clicking • High-Precision Timing"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkTopMost" Content="Pin Top" IsChecked="True"
                              Checked="OnTopMostChanged" Unchecked="OnTopMostChanged" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkAudio" Content="Sound FX" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SCROLLABLE BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>

                <!-- 1. TARGET WINDOW (ALT-TAB BACKGROUND MODE) -->
                <GroupBox Header="🎯 TARGETING MODE &amp; BACKGROUND (ALT-TAB)">
                    <StackPanel>
                        <!-- Mode Radio Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RadioModeBackground" Content="👻 Background (Alt-Tab)" IsChecked="True"
                                         Checked="OnTargetModeChanged"/>
                            <RadioButton x:Name="RadioModeCursor" Content="🖱️ Current Cursor"
                                         Checked="OnTargetModeChanged"/>
                            <RadioButton x:Name="RadioModeFixed" Content="📍 Fixed Screen"
                                         Checked="OnTargetModeChanged"/>
                        </StackPanel>

                        <!-- Big Interactive Target Picker Button -->
                        <Button x:Name="BtnPickTarget" Content="🎯 Interactive Target Window &amp; Point Picker (or press F7)"
                                Background="#0284C7" Height="36" Margin="0,0,0,10"
                                Click="OnBtnPickTargetClicked"/>

                        <!-- Window Dropdown Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbActiveWindows" Grid.Column="0" Height="30"
                                      SelectionChanged="OnWindowSelectionChanged"/>
                            <Button x:Name="BtnRefreshWindows" Grid.Column="1" Content="🔄 Refresh"
                                    Background="#334155" Margin="8,0,0,0" Width="85" Height="30"
                                    Click="OnBtnRefreshWindowsClicked"/>
                        </Grid>

                        <!-- Target Coordinates Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Client X:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtCoordX" Grid.Column="1" Text="100" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Client Y:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtCoordY" Grid.Column="3" Text="100" TextAlignment="Center"/>
                            <Button x:Name="BtnCenterWindow" Grid.Column="4" Content="📐 Center Window"
                                    Background="#334155" Margin="10,0,0,0" Height="28"
                                    Click="OnBtnCenterWindowClicked"/>
                        </Grid>

                        <!-- Target Summary & Test Click Row -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                                BorderBrush="{StaticResource BgCardBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtTargetSummary" Grid.Column="0"
                                           Text="Target: [Select or Pick a Window]"
                                           FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="BtnTestClick" Grid.Column="1" Content="⚡ Test 1 Click"
                                        Background="{StaticResource AccentEmerald}" Width="105" Height="28"
                                        Click="OnBtnTestClickClicked"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 2. CLICK INTERVAL / CPS -->
                <GroupBox Header="⚡ CLICK SPEED &amp; RATE">
                    <StackPanel>
                        <!-- CPS vs Exact Interval Header -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSpeedLabel" Grid.Column="0"
                                       Text="Speed: 10.0 CPS (100.0 ms interval)"
                                       FontFamily="Consolas" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkCpsMode" Grid.Column="1" Content="Direct CPS Mode"
                                      IsChecked="True" Checked="OnCpsModeChanged" Unchecked="OnCpsModeChanged"/>
                        </Grid>

                        <!-- CPS Slider Container -->
                        <StackPanel x:Name="PanelCps">
                            <Slider x:Name="SliderCps" Minimum="1" Maximum="250" Value="10" SmallChange="1" LargeChange="10"
                                    ValueChanged="OnCpsSliderChanged" Margin="0,4,0,8"/>
                            <WrapPanel Margin="0,2,0,4">
                                <TextBlock Text="Quick Presets: " Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="5" Width="34" Height="24" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="10" Width="34" Height="24" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="16" Width="34" Height="24" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="25" Width="34" Height="24" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="50" Width="34" Height="24" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="100" Width="38" Height="24" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="200" Width="38" Height="24" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Exact Interval Container (Hidden when CPS Mode) -->
                        <Grid x:Name="PanelInterval" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="2">
                                <TextBlock Text="Hours" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtHours" Text="0" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2">
                                <TextBlock Text="Mins" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtMins" Text="0" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="2">
                                <TextBlock Text="Secs" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtSecs" Text="0" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="2">
                                <TextBlock Text="Milliseconds" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtMs" Text="100" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 3. MOUSE BUTTON & TYPE -->
                <GroupBox Header="🖱️ MOUSE OPTIONS">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Mouse Button" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbMouseButton" SelectedIndex="0">
                                <ComboBoxItem Content="Left"/>
                                <ComboBoxItem Content="Right"/>
                                <ComboBoxItem Content="Middle"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Click Type" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbClickType" SelectedIndex="0">
                                <ComboBoxItem Content="Single"/>
                                <ComboBoxItem Content="Double"/>
                                <ComboBoxItem Content="Triple"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="Hold Duration (ms)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtHoldMs" Text="15" TextAlignment="Center" Height="28"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 4. ANTI-DETECTION & JITTER -->
                <GroupBox Header="🛡️ ANTI-DETECTION &amp; HUMANIZER SHIELD">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Randomizes delays and coordinates to bypass anti-AFK / bot filters"
                                       Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkJitter" Grid.Column="1" Content="Enable Shield" IsChecked="False"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="4">
                                <TextBlock Text="Interval Jitter (± ms)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBox x:Name="TxtJitterMs" Text="15" Margin="0,3,0,0" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4">
                                <TextBlock Text="Coordinate Radius (± px)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBox x:Name="TxtJitterPx" Text="3" Margin="0,3,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 5. REPEAT CONDITION -->
                <GroupBox Header="🔁 REPEAT LIMITATION">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RadioRepeatInfinite" Content="Repeat until stopped (Hotkey)" IsChecked="True"/>
                        <RadioButton x:Name="RadioRepeatCount" Content="Repeat" Margin="16,0,6,0"/>
                        <TextBox x:Name="TxtRepeatCount" Text="1000" Width="60" TextAlignment="Center"/>
                        <TextBlock Text="times" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM HUD -->
        <Border Grid.Row="2" Background="#090E17" CornerRadius="8" Padding="12,10"
                BorderBrush="{StaticResource BgCardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Badge -->
                <Border x:Name="BadgeStatus" Grid.Column="0" Background="#334155" CornerRadius="6" Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="● STOPPED" Foreground="{StaticResource TextSecondary}"
                               FontWeight="Bold" FontSize="12"/>
                </Border>

                <!-- Live Metrics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMetricClicks" Text="Clicks: 0"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="10,0"/>
                    <TextBlock x:Name="TxtMetricCps" Text="Speed: 0.0 CPS"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentCyan}" Margin="10,0"/>
                    <TextBlock x:Name="TxtMetricTime" Text="Time: 00:00:00"
                               FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="10,0"/>
                </StackPanel>

                <!-- Start/Stop Big Button -->
                <Button x:Name="BtnStartStop" Grid.Column="2" Content="▶ START (F6)"
                        Background="{StaticResource AccentEmerald}"
                        FontWeight="Bold" FontSize="14" Width="145" Height="42"
                        Click="OnBtnStartStopClicked"/>
            </Grid>
        </Border>

    </Grid>
</Window>
