<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoClicker"
        Width="500" Height="660"
        MinWidth="460" MinHeight="580"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable content -->
            <RowDefinition Height="Auto"/> <!-- Bottom HUD -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="2,0,2,8"
                BorderBrush="{StaticResource BgCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AutoClicker"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Desktop and background inactive window automation"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkTopMost" Content="Always on top" IsChecked="True"
                              Checked="OnTopMostChanged" Unchecked="OnTopMostChanged" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkAudio" Content="Audio cues" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>

                <!-- Mode Selection -->
                <GroupBox Header="Target mode">
                    <StackPanel Orientation="Horizontal" Margin="2,4">
                        <RadioButton x:Name="RadioModeBackground" Content="Background window (Alt-Tab)" IsChecked="True"
                                     Checked="OnTargetModeChanged"/>
                        <RadioButton x:Name="RadioModeCursor" Content="Current cursor"
                                     Checked="OnTargetModeChanged"/>
                        <RadioButton x:Name="RadioModeFixed" Content="Fixed coordinate"
                                     Checked="OnTargetModeChanged"/>
                    </StackPanel>
                </GroupBox>

                <!-- Background Target Settings -->
                <GroupBox x:Name="GrpBackgroundTarget" Header="Background target window">
                    <StackPanel>
                        <!-- Big Interactive Target Picker Button -->
                        <Button x:Name="BtnPickTarget" Content="Pick Window and Coordinate (F7)"
                                Background="#0284C7" Height="32" Margin="0,0,0,8"
                                Click="OnBtnPickTargetClicked"/>

                        <!-- Window Dropdown Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbActiveWindows" Grid.Column="0" Height="28"
                                      SelectionChanged="OnWindowSelectionChanged"/>
                            <Button x:Name="BtnRefreshWindows" Grid.Column="1" Content="Refresh"
                                    Background="#334155" Margin="8,0,0,0" Width="80" Height="28"
                                    Click="OnBtnRefreshWindowsClicked"/>
                        </Grid>

                        <!-- Target Coordinates Row -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtCoordX" Grid.Column="1" Text="100" TextAlignment="Center" Height="26"/>
                            <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="{StaticResource TextSecondary}"/>
                            <TextBox x:Name="TxtCoordY" Grid.Column="3" Text="100" TextAlignment="Center" Height="26"/>
                            <Button x:Name="BtnCenterWindow" Grid.Column="4" Content="Center on window"
                                    Background="#334155" Margin="8,0,8,0" Height="26"
                                    Click="OnBtnCenterWindowClicked"/>
                            <Button x:Name="BtnTestClick" Grid.Column="5" Content="Test click"
                                    Background="{StaticResource AccentEmerald}" Width="85" Height="26"
                                    Click="OnBtnTestClickClicked"/>
                        </Grid>

                        <TextBlock x:Name="TxtTargetSummary"
                                   Text="Target: [Select or pick a window]"
                                   FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" Margin="2,4,2,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </GroupBox>

                <!-- Click Interval / Rate -->
                <GroupBox Header="Click interval">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSpeedLabel" Grid.Column="0"
                                       Text="Speed: 10.0 CPS (100.0 ms interval)"
                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkCpsMode" Grid.Column="1" Content="CPS slider mode"
                                      IsChecked="True" Checked="OnCpsModeChanged" Unchecked="OnCpsModeChanged"/>
                        </Grid>

                        <!-- CPS Slider Container -->
                        <StackPanel x:Name="PanelCps">
                            <Slider x:Name="SliderCps" Minimum="1" Maximum="250" Value="10" SmallChange="1" LargeChange="10"
                                    ValueChanged="OnCpsSliderChanged" Margin="0,2,0,6"/>
                            <WrapPanel Margin="0,0,0,2">
                                <TextBlock Text="Quick presets:" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="5" Width="32" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="10" Width="32" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="16" Width="32" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="25" Width="32" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="50" Width="32" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="100" Width="36" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                                <Button Content="200" Width="36" Height="22" Background="#334155" Margin="2" Click="OnQuickCpsClicked"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Exact Interval Container -->
                        <Grid x:Name="PanelInterval" Visibility="Collapsed" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="2">
                                <TextBlock Text="Hours" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtHours" Text="0" TextAlignment="Center" Margin="0,2,0,0" Height="26"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2">
                                <TextBlock Text="Mins" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtMins" Text="0" TextAlignment="Center" Margin="0,2,0,0" Height="26"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="2">
                                <TextBlock Text="Secs" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtSecs" Text="0" TextAlignment="Center" Margin="0,2,0,0" Height="26"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="2">
                                <TextBlock Text="Milliseconds" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="TxtMs" Text="100" TextAlignment="Center" Margin="0,2,0,0" Height="26"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Click Options -->
                <GroupBox Header="Click options">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Mouse button" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbMouseButton" SelectedIndex="0" Height="28">
                                <ComboBoxItem Content="Left"/>
                                <ComboBoxItem Content="Right"/>
                                <ComboBoxItem Content="Middle"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Click type" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbClickType" SelectedIndex="0" Height="28">
                                <ComboBoxItem Content="Single"/>
                                <ComboBoxItem Content="Double"/>
                                <ComboBoxItem Content="Triple"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="Hold duration (ms)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtHoldMs" Text="15" TextAlignment="Center" Height="28"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Anti-Detection & Jitter -->
                <GroupBox Header="Anti-detection (Jitter)">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Randomizes delays and coordinates to avoid anti-AFK detection"
                                       Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkJitter" Grid.Column="1" Content="Enable" IsChecked="False"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="4">
                                <TextBlock Text="Interval variation (± ms)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBox x:Name="TxtJitterMs" Text="15" Margin="0,3,0,0" TextAlignment="Center" Height="26"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4">
                                <TextBlock Text="Coordinate scatter (± px)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBox x:Name="TxtJitterPx" Text="3" Margin="0,3,0,0" TextAlignment="Center" Height="26"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Click Repeat -->
                <GroupBox Header="Click repeat">
                    <StackPanel Orientation="Horizontal" Margin="2,2">
                        <RadioButton x:Name="RadioRepeatInfinite" Content="Repeat until stopped" IsChecked="True"/>
                        <RadioButton x:Name="RadioRepeatCount" Content="Repeat" Margin="16,0,6,0"/>
                        <TextBox x:Name="TxtRepeatCount" Text="1000" Width="60" TextAlignment="Center" Height="26"/>
                        <TextBlock Text="times" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="#0C121D" CornerRadius="6" Padding="10,8"
                BorderBrush="{StaticResource BgCardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Badge -->
                <Border x:Name="BadgeStatus" Grid.Column="0" Background="#334155" CornerRadius="4" Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Stopped" Foreground="{StaticResource TextSecondary}"
                               FontWeight="SemiBold" FontSize="11"/>
                </Border>

                <!-- Live Metrics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMetricClicks" Text="Clicks: 0"
                               FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="8,0"/>
                    <TextBlock x:Name="TxtMetricCps" Text="0.0 CPS"
                               FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentCyan}" Margin="8,0"/>
                    <TextBlock x:Name="TxtMetricTime" Text="00:00:00"
                               FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0"/>
                </StackPanel>

                <!-- Start/Stop Button -->
                <Button x:Name="BtnStartStop" Grid.Column="2" Content="Start (F6)"
                        Background="{StaticResource AccentEmerald}"
                        FontWeight="Bold" FontSize="13" Width="120" Height="36"
                        Click="OnBtnStartStopClicked"/>
            </Grid>
        </Border>

    </Grid>
</Window>
