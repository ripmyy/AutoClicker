<Window x:Class="AutoClicker.UI.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey Settings"
        Width="390" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgDark}">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Hotkey Configuration"
                   Foreground="{StaticResource TextPrimary}"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <!-- Inputs -->
        <StackPanel Grid.Row="1">
            <!-- Start/Stop Row -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Start / Stop:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <TextBox x:Name="TxtToggleKey" Grid.Column="1" Text="F6" IsReadOnly="True"
                         TextAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Height="28"/>
                <Button x:Name="BtnChangeToggle" Grid.Column="2" Content="Change"
                        Background="#334155" Height="28" Click="OnBtnChangeToggleClicked"/>
            </Grid>

            <!-- Target Picker Row -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Target Picker:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <TextBox x:Name="TxtPickKey" Grid.Column="1" Text="F7" IsReadOnly="True"
                         TextAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Height="28"/>
                <Button x:Name="BtnChangePick" Grid.Column="2" Content="Change"
                        Background="#334155" Height="28" Click="OnBtnChangePickClicked"/>
            </Grid>

            <TextBlock x:Name="TxtHint" Text="Click 'Change' and press any key on your keyboard."
                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnSave" Content="Save" Width="85" Height="30" Margin="0,0,8,0"
                    Background="{StaticResource AccentBlue}" Click="OnBtnSaveClicked"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="85" Height="30"
                    Background="#334155" Click="OnBtnCancelClicked"/>
        </StackPanel>
    </Grid>
</Window>
