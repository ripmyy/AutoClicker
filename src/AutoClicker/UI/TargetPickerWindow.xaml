<Window x:Class="AutoClicker.UI.TargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target Picker"
        Width="540" Height="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <Border Background="#F20F172A"
            BorderBrush="#00E5FF"
            BorderThickness="2"
            CornerRadius="10"
            Padding="12,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🎯 TARGET PICKER ACTIVE — HOVER OVER TARGET &amp; CLICK"
                       Foreground="#00E5FF"
                       FontWeight="Bold"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtLiveInfo"
                       Text="Inspecting: [Hover over target window...]"
                       Foreground="#F8FAFC"
                       FontFamily="Consolas"
                       FontSize="12"
                       Margin="0,3,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Left-Click on game to lock coordinates • Press ESC to cancel"
                       Foreground="#94A3B8"
                       FontSize="10"
                       Margin="0,2,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
