<Window x:Class="AutoClicker.UI.TargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target Picker"
        Width="500" Height="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <Border Background="#F0182030"
            BorderBrush="#38BDF8"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="12,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Target Picker Active - Hover Over Window and Click"
                       Foreground="#38BDF8"
                       FontWeight="SemiBold"
                       FontSize="12"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtLiveInfo"
                       Text="Inspecting: [Hover over target window...]"
                       Foreground="#F8FAFC"
                       FontFamily="Consolas"
                       FontSize="11"
                       Margin="0,3,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Left click on target window to lock. Press ESC to cancel."
                       Foreground="#94A3B8"
                       FontSize="10"
                       Margin="0,2,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
